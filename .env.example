# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Set to "true" for local dev to silence Vite HMR websocket errors (the HMR
# socket isn't proxied through the Express server).
DISABLE_HMR=

# GOOGLE_CLIENT_ID: Your Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET: Your Google OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=
# SESSION_SECRET: A secret string for session cookies
SESSION_SECRET=

# Firebase Admin (server-side). Off-GCP, point GOOGLE_APPLICATION_CREDENTIALS at a
# service account key file. This project uses a NAMED Firestore database (no
# "(default)"), so FIRESTORE_DATABASE_ID must match src/firebase.ts.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=gen-lang-client-0315145662
FIRESTORE_DATABASE_ID=ai-studio-3076a6e6-4299-41a2-b5a8-ecbe3cd8816c

# --- Mona Lisa Connect ---------------------------------------------------
# Nango handles OAuth for every non-Google provider in src/connect/catalog.ts.
# Start on Nango Cloud (free) then point NANGO_HOST at your self-hosted box.
NANGO_HOST=https://api.nango.dev
NANGO_SECRET_KEY=
# Shared secret you invent — appended to the webhook URLs you register in Nango
# and Canopy so only they can post connection status back to us.
CONNECT_WEBHOOK_SECRET=

# Canopy Connect — consumer-permissioned insurance policy pulls.
CANOPY_BASE=https://sandbox.usecanopy.com/api/v1.0.0
CANOPY_CLIENT_ID=
CANOPY_API_KEY=

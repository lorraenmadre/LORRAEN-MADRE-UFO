rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Is user authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is user the owner of this data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // Recursive rules for subcollections
      match /documents/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Mona Lisa Connect: the client reads its own connection status.
      // Writes come only from the server (Admin SDK bypasses these rules)
      // via the Nango / Canopy webhooks — never from the browser.
      match /connections/{connectorKey} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
